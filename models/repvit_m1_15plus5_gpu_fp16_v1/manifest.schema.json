{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bixolon.example/schemas/repvit_m1_15plus5_gpu_fp16_v1.json",
  "title": "RepViT-M1 15+5 RTX 5080 FP16 engine manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "model_id", "precision", "onnx", "engine", "runtime_manifest_sha256", "build_receipt", "fp16_calibration", "bindings"],
  "properties": {
    "schema_version": {"const": 1},
    "model_id": {"const": "repvit_m1_15plus5_gpu_fp16_v1"},
    "precision": {"const": "fp16"},
    "onnx": {"$ref": "#/$defs/file"},
    "engine": {"$ref": "#/$defs/file"},
    "runtime_manifest_sha256": {"$ref": "#/$defs/sha256"},
    "build_receipt": {"$ref": "#/$defs/file"},
    "fp16_calibration": {"$ref": "#/$defs/calibration"},
    "bindings": {"const": [
      {"name": "crops", "mode": "input", "dtype": "float16", "shape": [14, 3, 224, 224], "semantic": "tight_context_rows"},
      {"name": "logits", "mode": "output", "dtype": "float16", "shape": [14, 20], "semantic": "sku_logits"}
    ]}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256", "calibration_id"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "calibration_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
